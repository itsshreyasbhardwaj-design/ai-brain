# ---------------------------------------------------------------------------
# AI BRAIN configuration
#
# Copy to .env. Every value below has a working default except APP_SECRET,
# which you need before you can store a connector credential.
# ---------------------------------------------------------------------------

# Where your data lives. One SQLite file, created on first run.
AI_BRAIN_DB=./data/brain.db

# Encrypts connector credentials (AES-256-GCM) at rest. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it makes already-stored credentials undecryptable, so keep it safe.
APP_SECRET=

# ---------------------------------------------------------------------------
# AI provider (entirely optional)
#
# Leave AI_PROVIDER unset or 'none' and everything still works: answers,
# reviews and recommendations are computed from your records by fixed rules.
# A provider can only *rephrase* an answer that was already computed.
#
#   none              the default. No network, no cost.
#   ollama            a local model. No key, no cost. Needs Ollama running.
#   anthropic         paid API.
#   openai-compatible paid API, or any /v1/chat/completions gateway.
# ---------------------------------------------------------------------------
AI_PROVIDER=none
# AI_MODEL=llama3.2
# AI_API_KEY=
# AI_BASE_URL=
# AI_MAX_OUTPUT_TOKENS=600

# Spending cap in minor units (cents). An API key alone does NOT authorize
# spending: this must be set to a non-zero value, and a call estimated to
# exceed the remaining budget is refused before it is made.
AI_MONTHLY_BUDGET_MINOR=0

# Prices for the cost estimate, per million tokens, in minor units.
# AI_PRICE_INPUT_PER_MILLION_MINOR=300
# AI_PRICE_OUTPUT_PER_MILLION_MINOR=1500

# ---------------------------------------------------------------------------
# GitHub webhooks (optional)
#
# Set this to the same secret you configure on the repository webhook. Without
# it the endpoint refuses every request rather than accepting unverified ones.
# ---------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# Standard Node setting. Leave as development for `pnpm dev`.
NODE_ENV=development
